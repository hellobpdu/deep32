{
  "$id": "urn:deep32:selftest-questions:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bundle_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "type": "string"
    },
    "fixture_only": {
      "type": "boolean"
    },
    "questions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "collection": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "maxLength": 64,
                "minLength": 1,
                "type": "string"
              }
            ]
          },
          "id": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "labels": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "doc_key": {
                  "maxLength": 256,
                  "minLength": 1,
                  "type": "string"
                },
                "exact_span": {
                  "maxLength": 4000,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "doc_key",
                "exact_span"
              ],
              "type": "object"
            },
            "maxItems": 32,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "text": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "text",
          "collection",
          "labels"
        ],
        "type": "object"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array"
    },
    "release": {
      "const": "v0.1.0-alpha.3"
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "schema_version",
    "bundle_id",
    "release",
    "fixture_only",
    "questions"
  ],
  "title": "Deep32 selftest-questions version 1",
  "type": "object"
}
