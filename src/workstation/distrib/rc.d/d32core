#!/bin/ksh
#
# d32core: production deep32-engine (CPython 3.12) as _d32core, the RAG_CORE of First light
# Deep32 Workstation rc.d SKELETON (BASE lane, D.32.12). PYRAG owns the launcher and replaces this file; BASE keeps the contract below.
#
# Contract (rc.subr(8) conventions):
#  - runs as _d32core; its login class is "d32core" (/etc/login.conf.d/d32core, schg): rc.subr picks the class named
#    after the script, so limits and fixed environment live there, not in rc.conf.local;
#  - rc_reload=NO: a configuration change needs a local restart (ISO 3.1 item 8);
#  - root work (pre-binding sockets with their owner and mode, creating run-time directories) happens in rc_pre or in
#    the launcher before it drops to _d32core; the launcher then imports, binds, unveils and pledges, in that order;
#  - FIX-05/FIX-04: RAG_TRACE=off and RAG_DB_IMMUTABLE=1 come from the login class; rc_pre refuses to start
#    if the class lost them. core.sock 0660 root:_d32edge; SQLITE_TMPDIR /var/d32/run/core-tmp (0700 _d32core);
#  - until the real launcher is installed, a TEST image (marker /etc/d32/standin) runs /usr/local/d32/libexec/d32-standin
#    in its place, which proves the user, class and rc plumbing and nothing else. Real images never carry the marker
#    (release/lint.sh refuses it).

daemon="/usr/local/d32/sbin/d32core-launch"
daemon_user="_d32core"
daemon_flags=""
daemon_timeout=60

. /etc/rc.d/rc.subr

rc_bg=YES
rc_reload=NO

_standin=/usr/local/d32/libexec/d32-standin
if [[ ! -x /usr/local/d32/sbin/d32core-launch && -f /etc/d32/standin && -x $_standin ]]; then
	daemon=$_standin
	daemon_flags=d32core
	pexp="/bin/ksh $_standin d32core"
fi

rc_pre() {
	install -d -o root -g wheel -m 0755 /var/run/d32
	# FIX-04/FIX-05: refuse to start unless the class still carries the immutable-database and traces-off settings.
	# The path list must end in /etc/login.conf, as rc.subr's own getcap does: the class ends in tc=daemon, and
	# without login.conf getcap cannot resolve it ("unable to lookup d32core", exit 1), so the guard refused always.
	local _cap
	_cap=$(getcap -f /etc/login.conf.d/d32core:/etc/login.conf -s setenv d32core) || return 1
	[[ ,$_cap, == *,RAG_TRACE=off,* ]] || return 1
	[[ ,$_cap, == *,RAG_DB_IMMUTABLE=1,* ]] || return 1
	install -d -o _d32core -g _d32core -m 0700 /var/d32/run/core-tmp
}

rc_cmd $1
