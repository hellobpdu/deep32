#!/usr/local/bin/python3.14 -IB
"""Enrol one committed Forge peer. Exit 0 stored; 6 local enrolment failed.

Run as root. Values are read from pairing state, never argv or environment.
GPU_EXT stays off until its existing model attestation succeeds when enabled.
"""
import os
from pathlib import Path
import subprocess
import sys
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from deep32net.enrol import enrol_forge
from deep32net.files import atomic_write


def main():
    if len(sys.argv) != 2 or os.geteuid() != 0:
        return 6
    try:
        # Fail closed before replacing a credential or retaining old connection pools.
        atomic_write('/etc/d32/state/gpu_ext', b'off\n')
        stopped = subprocess.run(['/usr/sbin/rcctl', 'stop', 'd32accel'],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        check = subprocess.run(['/usr/sbin/rcctl', 'check', 'd32accel'],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if check.returncode == 0:
            raise RuntimeError()
        enrol_forge(Path('/var/db/d32/net'), sys.argv[1])
        return 0
    except Exception:
        sys.stderr.write('d32-forge-enrol: enrolment failed; GPU_EXT remains off\n')
        return 6


raise SystemExit(main())
