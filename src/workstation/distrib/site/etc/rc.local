# /etc/rc.local: Deep32 Workstation (BASE lane; schg). rc runs this after pkg_scripts, before cron and the login
# manager, at the securelevel already set by rc.securelevel.

# upstream resolvers from the DHCP lease into pf <dns> and unbound (ISO 2.6.3); table edit only
[ -x /usr/local/d32/sbin/d32-dnsup ] && /usr/local/d32/sbin/d32-dnsup -w 30

# test images only: the first-boot check, once, on the console and in /var/log/d32-firstboot-check.log
if [ -f /var/db/d32/firstboot-check ] && [ -x /usr/local/d32/libexec/d32-firstboot-check ]; then
	/usr/local/d32/libexec/d32-firstboot-check 2>&1 | tee /var/log/d32-firstboot-check.log
	rm -f /var/db/d32/firstboot-check
fi
