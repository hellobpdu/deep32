# Deep32 Workstation login class (BASE lane). login.conf(5): /etc/login.conf.d/<class> takes precedence over
# /etc/login.conf; "tc=" reaches only this file and /etc/login.conf, so each class is complete in itself.
# rc.d d32core: production deep32-engine as _d32core (HARDENING 5.8). FIX-05 (traces off) and FIX-04 (immutable
# database) are set here, in a schg file, so no rc.conf.local line can undo them; d32ready also checks them.
# datasize 4 GiB is provisional for Python First light (the dense matrix lives in-process); PYRAG measures it.
d32core:\
	:datasize=4096M:\
	:coredumpsize=0:\
	:setenv=RAG_TRACE=off,RAG_DB_IMMUTABLE=1,SQLITE_TMPDIR=/var/d32/run/core-tmp,PYTHONDONTWRITEBYTECODE=1:\
	:tc=daemon:
