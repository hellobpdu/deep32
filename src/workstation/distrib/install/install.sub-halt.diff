# TEST MEDIA ONLY: after an unattended install, power off instead of rebooting when /d32-halt-after-install exists
# in the ramdisk, so a VM does not boot the installer again. Against OpenBSD 8.0 install.sub (65,074 bytes; its
# sha256 is checked by release/mkimage.sh). The real installer front end (d32setup) halts or reboots itself.
--- install.sub
+++ install.sub
@@ -2463,6 +2463,7 @@
 
 	prep_root_mail /tmp/ai/ai.log "$(hostname) $AI_MODE log"
 
+	[[ -f /d32-halt-after-install ]] && exec halt -p
 	exec reboot
 }
 
