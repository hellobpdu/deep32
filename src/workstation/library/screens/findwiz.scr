d32scr 1
# Deep32 Library: the complete Find Wizard, retaining the intro and category geometry from the 1995 captures (15-28;
# AUTHENTICITY.md). Build 1 had the wizard as an inferred, centred overlay with a 47-px button strip and a Cancel
# button; the captures show a captioned window docked on the article page instead:
# [m] the window: (10,65) in the work area, 511x356, a 1-px black frame; [m256] a 15-px caption in entry 27 (rows
#     1-15; the "light edges" on rows 1 and 15 were the 16-colour dither) carrying the spaced capitals of string
#     13450 "FIND WIZARD" in white after a marker, and "Close" in entry 31 after a 1-px entry-7 bar at its right
#     end; on the first page FINDIT_SCREEN from row 16, on the areas page the picture column (entry 28) from row 16
#     and a black rule along the page's top and left (row 16 from x 128, column 128), the page (129,17) 381x338.
# [m] Back and Next sit at the bottom left of the page, (16,307) and (75,307); Find (the areas page) at the top
#     right, (408,26); the nine category buttons abut in two columns at x 150 and 320, rows 131 + 43k; the radios
#     read "No" and "Yes" (strings 20535, 20536) at (147,87) and (147,108).
# [d] FINDIT_SCREEN 510x344 (the first page), FW_CAT_BMP 127x161, FINDWIZARD_CATBUTT1-9 680x43 (CATBUTT5 680x44)
#     = 4 frames of 170x43, FINDWIZARD_NEXT/BACK 156x39 = 4 x 39x39, FINDWIZARD_FIND 360x29 = 4 x 90x29,
#     FINDWIZARD_RADIOBUTTON_1 48x12 = 4 x 12x12.
# Frame meanings of the record-made push buttons and radios [c] (seg19:14b1; artefacts PALETTE.md 3): push buttons
# 0 at rest, 1 pressed, 2 disabled, 3 under the pointer; radio 0 clear, 1 set or down, 2 disabled, 3 under the
# pointer. Category buttons, from the pixels: 0 a white box, 1 ticked, 2 an empty grey box, 3 a grey tick. [m] 2 is
# the disabled look: with "No" set all nine show an empty grey box (captures 20 and 24; pressing one then changes
# nothing). [i] 3 disabled while ticked; 2 also while pressed (a pushed Windows check box is grey).
# Colours are ui:<n> (the interface colour table, read from the store). [m256] every one is its table entry exactly
# on the 256-colour captures (15-27): caption 27, the areas page 13, the picture column 28, the question and the
# rule under it 12, Close 31.
# Build 2: the category buttons are his own (the category-art lane's Find Wizard strips, 680x43 = 4 x 170x43:
# normal, checked, pressed, disabled; `category <n>` draws e26/fw/<id>), his twenty categories on two pages of ten in
# the Library's nine slots and the tenth it left empty; the missing questions below retain this frame.

block wizcaption
	control cap
		kind bar
		rect 1 1 509 15                       # [m256] rows 1-15, entry 27 throughout (was rows 2-14 between light edges)
		bg ui:27                              # [m256]
		label @13450                          # [d] "FIND WIZARD"
		upper
		tracking 3                            # [m256] as the main caption: every glyph on the capture's columns (3.1 put
		                                      #     "WIZARD" 1 px right)
		text-y 12                             # [m] baseline on row 13 of the window
		font ui
		fg ui:0                               # [m] white lettering and marker
		marker
		text-x 17                             # [m] marker at 5-11, lettering from 17
	end
	control close-bar
		kind panel
		rect 475 4 1 9                        # [m256] a 1-px bar in entry 7 before "Close" (frame x 486, rows 85-93)
		bg ui:7
	end
	control close
		kind label
		rect 476 3 33 11                      # [m] "Close" from x 479 to 503 (frame 491-514 on capture256 20)
		bg ui:27
		fg ui:31                              # [m256] entry 31 (16 colours: white)
		label @6003                           # [d] "Close"
		font ui10                             # [m256] Arial 10 px: 24x7 ink at x 491-514, rows 86-92 (Arial 11 is 26x8)
		align centre
		text-y 9                              # [m256] glyphs end on frame row 92
		action close
		key Escape
	end
	control frame-bottom
		kind panel
		rect 0 355 511 1                      # the black frame's bottom row and right column (FINDIT_SCREEN is
		bg ui:15                              # 510x344, wider and taller than the page; it is drawn first)
	end
	control frame-right
		kind panel
		rect 510 0 1 356
		bg ui:15
	end
end

screen findwiz
	size 511 356
	origin 10 65                              # [m] in the work area of the screen under it
	over *                                    # [m] over the page in front (the article on captures 15-28)
	ground ui:15                              # [m] the black frame
	image ui/bitmap/FINDIT_SCREEN 1 16        # [m256] at (1,16): frame (12,97), 98.4% of its pixels exact on capture256 15
	                                          #     (the 16-colour match had put it at (1,15)); its first row, entry 28,
	                                          #     is the line under the caption, where a black rule was drawn before
	uses wizcaption
	control back
		kind button
		record 10081                          # [d] "|^FINDWIZARD_BACK"
		rect 16 307 39 39                     # [m] capture 15
		strip ui/bitmap/FINDWIZARD_BACK 4
		frame normal 0
		frame pressed 1
		frame disabled 2
		frame hot 3
		disabled                              # nothing to go back to on the first page
	end
	control next
		kind button
		record 10080                          # [d] "|^FINDWIZARD_NEXT"
		rect 75 307 39 39                     # [m] capture 17: pressing Next changes 37x37 at (76,308) inside it
		strip ui/bitmap/FINDWIZARD_NEXT 4
		frame normal 0
		frame pressed 1
		frame disabled 2
		frame hot 3
		action finder.next "Next page"
		key Return
	end
end

screen findwiz-areas
	size 511 356
	origin 10 65
	over *
	ground ui:15
	uses wizcaption
	control picture-column
		kind panel
		rect 1 16 127 339                     # [m256] the dark column, x 1-127 (frame 12-138), rows 16-354
		bg ui:28
	end
	control page-rule
		kind panel
		rect 128 16 382 1                     # [m256] a black rule along the page's top, frame x 139-520, row 97
		bg ui:15
	end
	control column-rule
		kind panel
		rect 128 16 1 339                     # [m256] and down its left, frame x 139 (the 16-colour dither had hidden
		bg ui:15                              #     it in the column's black)
	end
	control picture
		kind image
		rect 1 16 127 161                     # [m256] at frame (12,97), every pixel exact (capture256 20)
		strip ui/bitmap/FW_CAT_BMP@ui 1       # [m256] through the interface palette (xassets.c, SCREEN-FORMAT.md)
	end
	control panel
		kind panel
		rect 129 17 381 338                   # [m256] from frame x 140 (was 141)
		bg ui:13
	end
	# [m256] The question is not string 20546: the 256-colour capture reads "Do you want to search for articles" and
	# "in one or more categories?", two strings of the period program's data segment (file offset 78,545, after the
	# CATBUTT names, before "Yes" and "No"; not in the string table), set as two lines in Arial 13 px regular, entry
	# 12 (the 16-colour capture had suggested a larger bold face); ink from x 159. A rule in entry 12 runs under it.
	control question
		kind label
		rect 147 46 300 13                    # [m256] capitals on frame rows 127-136
		label "Do you want to search for articles"
		font body                             # [m256] Arial 13 px regular ([i] it follows the type size; S is 13 px)
		fg ui:12                              # [m256] entry 12 exactly
		                                      # [m256] ink x 159-350, no extra spacing
		text-y 10                             # [m256] 5 and 1 ink pixels differ from capture256 20 (of 430, 334)
		align left
	end
	control question-2
		kind label
		rect 147 59 300 13                    # [m256] capitals on frame rows 140-149
		label "in one or more categories?"
		font body
		fg ui:12
		                                      # [m256] ink x 159-310
		text-y 10                             # [m256] 5 and 1 ink pixels differ from capture256 20 (of 430, 334)
		align left
	end
	control question-rule
		kind panel
		rect 147 76 351 1                     # [m256] frame x 158-508, row 157, entry 12
		bg ui:12
	end
	# [m256] The radios are FINDWIZARD_RADIOBUTTON_5 (record 10088: every frame slot 13, the page's colour), the
	# design for this page's ground: a 10-px circle with entry-11 edges; its 12x12 frame sits at (147,86) and
	# (147,107), 1 px higher than measured through the 16-colour dither, and the class frame paints its outer ring
	# in entry 13 (capture256 20, 25). The lettering stays where capture 20 matched it pixel for pixel (text-y 11).
	control all
		kind radio
		record 10088                          # [d] "|^FINDWIZARD_RADIOBUTTON_5"
		rect 147 86 160 12                    # [m256]
		strip ui/bitmap/FINDWIZARD_RADIOBUTTON_5 4
		frame normal 0                        # [c] the radio frames (style 0x40, type 0x09; seg19:14b1):
		frame checked 1                       #     at rest 0, down or set 1, disabled 2 (grey ring), under the
		frame pressed 1                       #     pointer 3 (the same pixels as 0)
		frame disabled 2
		frame hot 3
		label @20535                          # [d] "No": not only some areas, so all of them
		fg ui:15                              # [m] black on the light page
		text-y 11                             # [m] the lettering's baseline as before (frame row 178)
		group scope
		state scope-all                       # shared with the other category page
		checked
		action select
	end
	control some
		kind radio
		record 10088
		rect 147 107 160 12                   # [m256]
		strip ui/bitmap/FINDWIZARD_RADIOBUTTON_5 4
		frame normal 0
		frame checked 1
		frame pressed 1
		frame disabled 2
		frame hot 3
		label @20536                          # [d] "Yes": only the areas ticked below
		fg ui:15
		text-y 11
		group scope
		state scope-some
		action select
	end
	control cat1
		kind toggle
		rect 150 131 170 43                   # [m] (161,212) on capture 20
		category 1                           # his 1st category (TAXONOMY.json order); its strip is his art
		strip e26/fw 4                        #     e26/fw/<id>: 680x43 = 4 x 170x43, normal, checked, pressed, disabled
		frame normal 0
		frame checked 1
		frame pressed 2
		frame disabled 2                      # [m] the empty grey box while "No" is set (captures 20, 24), his frame 2
		frame checked-disabled 3              # [i] his frame 3: the grey tick
		group areas
		enabled-by some
		action toggle
	end
	control cat2
		kind toggle
		rect 150 174 170 43
		category 2                           # his 2nd category (TAXONOMY.json order); its strip is his art
		strip e26/fw 4                        #     e26/fw/<id>: 680x43 = 4 x 170x43, normal, checked, pressed, disabled
		frame normal 0
		frame checked 1
		frame pressed 2
		frame disabled 2                      # [m] the empty grey box while "No" is set (captures 20, 24), his frame 2
		frame checked-disabled 3              # [i] his frame 3: the grey tick
		group areas
		enabled-by some
		action toggle
	end
	control cat3
		kind toggle
		rect 150 217 170 43
		category 3                           # his 3rd category (TAXONOMY.json order); its strip is his art
		strip e26/fw 4                        #     e26/fw/<id>: 680x43 = 4 x 170x43, normal, checked, pressed, disabled
		frame normal 0
		frame checked 1
		frame pressed 2
		frame disabled 2                      # [m] the empty grey box while "No" is set (captures 20, 24), his frame 2
		frame checked-disabled 3              # [i] his frame 3: the grey tick
		group areas
		enabled-by some
		action toggle
	end
	control cat4
		kind toggle
		rect 150 260 170 43
		category 4                           # his 4th category (TAXONOMY.json order); its strip is his art
		strip e26/fw 4                        #     e26/fw/<id>: 680x43 = 4 x 170x43, normal, checked, pressed, disabled
		frame normal 0
		frame checked 1
		frame pressed 2
		frame disabled 2                      # [m] the empty grey box while "No" is set (captures 20, 24), his frame 2
		frame checked-disabled 3              # [i] his frame 3: the grey tick
		group areas
		enabled-by some
		action toggle
	end
	control cat5
		kind toggle
		rect 150 303 170 43
		category 5                           # his 5th category (TAXONOMY.json order); its strip is his art
		strip e26/fw 4                        #     e26/fw/<id>: 680x43 = 4 x 170x43, normal, checked, pressed, disabled
		frame normal 0
		frame checked 1
		frame pressed 2
		frame disabled 2                      # [m] the empty grey box while "No" is set (captures 20, 24), his frame 2
		frame checked-disabled 3              # [i] his frame 3: the grey tick
		group areas
		enabled-by some
		action toggle
	end
	control cat6
		kind toggle
		rect 320 131 170 43                   # [m] (331,212) on capture 20
		category 6                           # his 6th category (TAXONOMY.json order); its strip is his art
		strip e26/fw 4                        #     e26/fw/<id>: 680x43 = 4 x 170x43, normal, checked, pressed, disabled
		frame normal 0
		frame checked 1
		frame pressed 2
		frame disabled 2                      # [m] the empty grey box while "No" is set (captures 20, 24), his frame 2
		frame checked-disabled 3              # [i] his frame 3: the grey tick
		group areas
		enabled-by some
		action toggle
	end
	control cat7
		kind toggle
		rect 320 174 170 43
		category 7                           # his 7th category (TAXONOMY.json order); its strip is his art
		strip e26/fw 4                        #     e26/fw/<id>: 680x43 = 4 x 170x43, normal, checked, pressed, disabled
		frame normal 0
		frame checked 1
		frame pressed 2
		frame disabled 2                      # [m] the empty grey box while "No" is set (captures 20, 24), his frame 2
		frame checked-disabled 3              # [i] his frame 3: the grey tick
		group areas
		enabled-by some
		action toggle
	end
	control cat8
		kind toggle
		rect 320 217 170 43
		category 8                           # his 8th category (TAXONOMY.json order); its strip is his art
		strip e26/fw 4                        #     e26/fw/<id>: 680x43 = 4 x 170x43, normal, checked, pressed, disabled
		frame normal 0
		frame checked 1
		frame pressed 2
		frame disabled 2                      # [m] the empty grey box while "No" is set (captures 20, 24), his frame 2
		frame checked-disabled 3              # [i] his frame 3: the grey tick
		group areas
		enabled-by some
		action toggle
	end
	control cat9
		kind toggle
		rect 320 260 170 43
		category 9                           # his 9th category (TAXONOMY.json order); its strip is his art
		strip e26/fw 4                        #     e26/fw/<id>: 680x43 = 4 x 170x43, normal, checked, pressed, disabled
		frame normal 0
		frame checked 1
		frame pressed 2
		frame disabled 2                      # [m] the empty grey box while "No" is set (captures 20, 24), his frame 2
		frame checked-disabled 3              # [i] his frame 3: the grey tick
		group areas
		enabled-by some
		action toggle
	end
	control cat10
		kind toggle
		rect 320 303 170 43                   # [i] the tenth slot, empty in the period design (nine areas)
		category 10                           # his 10th category (TAXONOMY.json order); its strip is his art
		strip e26/fw 4                        #     e26/fw/<id>: 680x43 = 4 x 170x43, normal, checked, pressed, disabled
		frame normal 0
		frame checked 1
		frame pressed 2
		frame disabled 2                      # [m] the empty grey box while "No" is set (captures 20, 24), his frame 2
		frame checked-disabled 3              # [i] his frame 3: the grey tick
		group areas
		enabled-by some
		action toggle
	end
	control find
		kind button
		record 10082                          # [d] "|^FINDWIZARD_FIND"; its frame slots 3-6 are all entry 28, so the
		                                      #     class's 1-px ring is entry 28 in every state (black at 16 colours
		                                      #     on all four sides, captures 20, 26, 27), not the strip's #52845B
		rect 408 26 90 29                     # [m] (419,107) on capture 20; pressing changes 88x27 at (420,108)
		strip ui/bitmap/FINDWIZARD_FIND 4
		frame normal 0
		frame pressed 1
		frame disabled 2
		frame hot 3
		action wizard.find "Search"
		key Return
	end
	control back
		kind button
		record 10081
		rect 16 307 39 39                     # [m]
		strip ui/bitmap/FINDWIZARD_BACK 4
		frame normal 0
		frame pressed 1
		frame disabled 2
		frame hot 3
		action finder.back "Previous page"
	end
	control next
		kind button
		record 10080
		rect 75 307 39 39                     # [m]
		strip ui/bitmap/FINDWIZARD_NEXT 4
		frame normal 0
		frame pressed 1
		frame disabled 2
		frame hot 3
		action finder.next "Next page"
	end
end

# The second page of his categories (11-20): TAXONOMY.json asks for two pages of 2x5 (its geometry,
# find_wizard_category_pages). Next continues to optional subcategories, then Media and Time.
# The radios and ticks are shared with the first page (state).
screen findwiz-areas-2
	size 511 356
	origin 10 65
	over *
	ground ui:15
	uses wizcaption
	control picture-column
		kind panel
		rect 1 16 127 339                     # [m256] the dark column, x 1-127 (frame 12-138), rows 16-354
		bg ui:28
	end
	control page-rule
		kind panel
		rect 128 16 382 1                     # [m256] a black rule along the page's top, frame x 139-520, row 97
		bg ui:15
	end
	control column-rule
		kind panel
		rect 128 16 1 339                     # [m256] and down its left, frame x 139 (the 16-colour dither had hidden
		bg ui:15                              #     it in the column's black)
	end
	control picture
		kind image
		rect 1 16 127 161                     # [m256] at frame (12,97), every pixel exact (capture256 20)
		strip ui/bitmap/FW_CAT_BMP@ui 1       # [m256] through the interface palette (xassets.c, SCREEN-FORMAT.md)
	end
	control panel
		kind panel
		rect 129 17 381 338                   # [m256] from frame x 140 (was 141)
		bg ui:13
	end
	# [m256] The question is not string 20546: the 256-colour capture reads "Do you want to search for articles" and
	# "in one or more categories?", two strings of the period program's data segment (file offset 78,545, after the
	# CATBUTT names, before "Yes" and "No"; not in the string table), set as two lines in Arial 13 px regular, entry
	# 12 (the 16-colour capture had suggested a larger bold face); ink from x 159. A rule in entry 12 runs under it.
	control question
		kind label
		rect 147 46 300 13                    # [m256] capitals on frame rows 127-136
		label "Do you want to search for articles"
		font body                             # [m256] Arial 13 px regular ([i] it follows the type size; S is 13 px)
		fg ui:12                              # [m256] entry 12 exactly
		                                      # [m256] ink x 159-350, no extra spacing
		text-y 10                             # [m256] 5 and 1 ink pixels differ from capture256 20 (of 430, 334)
		align left
	end
	control question-2
		kind label
		rect 147 59 300 13                    # [m256] capitals on frame rows 140-149
		label "in one or more categories?"
		font body
		fg ui:12
		                                      # [m256] ink x 159-310
		text-y 10                             # [m256] 5 and 1 ink pixels differ from capture256 20 (of 430, 334)
		align left
	end
	control question-rule
		kind panel
		rect 147 76 351 1                     # [m256] frame x 158-508, row 157, entry 12
		bg ui:12
	end
	# [m256] The radios are FINDWIZARD_RADIOBUTTON_5 (record 10088: every frame slot 13, the page's colour), the
	# design for this page's ground: a 10-px circle with entry-11 edges; its 12x12 frame sits at (147,86) and
	# (147,107), 1 px higher than measured through the 16-colour dither, and the class frame paints its outer ring
	# in entry 13 (capture256 20, 25). The lettering stays where capture 20 matched it pixel for pixel (text-y 11).
	control all
		kind radio
		record 10088                          # [d] "|^FINDWIZARD_RADIOBUTTON_5"
		rect 147 86 160 12                    # [m256]
		strip ui/bitmap/FINDWIZARD_RADIOBUTTON_5 4
		frame normal 0                        # [c] the radio frames (style 0x40, type 0x09; seg19:14b1):
		frame checked 1                       #     at rest 0, down or set 1, disabled 2 (grey ring), under the
		frame pressed 1                       #     pointer 3 (the same pixels as 0)
		frame disabled 2
		frame hot 3
		label @20535                          # [d] "No": not only some areas, so all of them
		fg ui:15                              # [m] black on the light page
		text-y 11                             # [m] the lettering's baseline as before (frame row 178)
		group scope
		state scope-all                       # shared with the other category page
		checked
		action select
	end
	control some
		kind radio
		record 10088
		rect 147 107 160 12                   # [m256]
		strip ui/bitmap/FINDWIZARD_RADIOBUTTON_5 4
		frame normal 0
		frame checked 1
		frame pressed 1
		frame disabled 2
		frame hot 3
		label @20536                          # [d] "Yes": only the areas ticked below
		fg ui:15
		text-y 11
		group scope
		state scope-some
		action select
	end
	control cat11
		kind toggle
		rect 150 131 170 43                   # [m] (161,212) on capture 20
		category 11                           # his 11th category (TAXONOMY.json order); its strip is his art
		strip e26/fw 4                        #     e26/fw/<id>: 680x43 = 4 x 170x43, normal, checked, pressed, disabled
		frame normal 0
		frame checked 1
		frame pressed 2
		frame disabled 2                      # [m] the empty grey box while "No" is set (captures 20, 24), his frame 2
		frame checked-disabled 3              # [i] his frame 3: the grey tick
		group areas
		enabled-by some
		action toggle
	end
	control cat12
		kind toggle
		rect 150 174 170 43
		category 12                           # his 12th category (TAXONOMY.json order); its strip is his art
		strip e26/fw 4                        #     e26/fw/<id>: 680x43 = 4 x 170x43, normal, checked, pressed, disabled
		frame normal 0
		frame checked 1
		frame pressed 2
		frame disabled 2                      # [m] the empty grey box while "No" is set (captures 20, 24), his frame 2
		frame checked-disabled 3              # [i] his frame 3: the grey tick
		group areas
		enabled-by some
		action toggle
	end
	control cat13
		kind toggle
		rect 150 217 170 43
		category 13                           # his 13th category (TAXONOMY.json order); its strip is his art
		strip e26/fw 4                        #     e26/fw/<id>: 680x43 = 4 x 170x43, normal, checked, pressed, disabled
		frame normal 0
		frame checked 1
		frame pressed 2
		frame disabled 2                      # [m] the empty grey box while "No" is set (captures 20, 24), his frame 2
		frame checked-disabled 3              # [i] his frame 3: the grey tick
		group areas
		enabled-by some
		action toggle
	end
	control cat14
		kind toggle
		rect 150 260 170 43
		category 14                           # his 14th category (TAXONOMY.json order); its strip is his art
		strip e26/fw 4                        #     e26/fw/<id>: 680x43 = 4 x 170x43, normal, checked, pressed, disabled
		frame normal 0
		frame checked 1
		frame pressed 2
		frame disabled 2                      # [m] the empty grey box while "No" is set (captures 20, 24), his frame 2
		frame checked-disabled 3              # [i] his frame 3: the grey tick
		group areas
		enabled-by some
		action toggle
	end
	control cat15
		kind toggle
		rect 150 303 170 43
		category 15                           # his 15th category (TAXONOMY.json order); its strip is his art
		strip e26/fw 4                        #     e26/fw/<id>: 680x43 = 4 x 170x43, normal, checked, pressed, disabled
		frame normal 0
		frame checked 1
		frame pressed 2
		frame disabled 2                      # [m] the empty grey box while "No" is set (captures 20, 24), his frame 2
		frame checked-disabled 3              # [i] his frame 3: the grey tick
		group areas
		enabled-by some
		action toggle
	end
	control cat16
		kind toggle
		rect 320 131 170 43                   # [m] (331,212) on capture 20
		category 16                           # his 16th category (TAXONOMY.json order); its strip is his art
		strip e26/fw 4                        #     e26/fw/<id>: 680x43 = 4 x 170x43, normal, checked, pressed, disabled
		frame normal 0
		frame checked 1
		frame pressed 2
		frame disabled 2                      # [m] the empty grey box while "No" is set (captures 20, 24), his frame 2
		frame checked-disabled 3              # [i] his frame 3: the grey tick
		group areas
		enabled-by some
		action toggle
	end
	control cat17
		kind toggle
		rect 320 174 170 43
		category 17                           # his 17th category (TAXONOMY.json order); its strip is his art
		strip e26/fw 4                        #     e26/fw/<id>: 680x43 = 4 x 170x43, normal, checked, pressed, disabled
		frame normal 0
		frame checked 1
		frame pressed 2
		frame disabled 2                      # [m] the empty grey box while "No" is set (captures 20, 24), his frame 2
		frame checked-disabled 3              # [i] his frame 3: the grey tick
		group areas
		enabled-by some
		action toggle
	end
	control cat18
		kind toggle
		rect 320 217 170 43
		category 18                           # his 18th category (TAXONOMY.json order); its strip is his art
		strip e26/fw 4                        #     e26/fw/<id>: 680x43 = 4 x 170x43, normal, checked, pressed, disabled
		frame normal 0
		frame checked 1
		frame pressed 2
		frame disabled 2                      # [m] the empty grey box while "No" is set (captures 20, 24), his frame 2
		frame checked-disabled 3              # [i] his frame 3: the grey tick
		group areas
		enabled-by some
		action toggle
	end
	control cat19
		kind toggle
		rect 320 260 170 43
		category 19                           # his 19th category (TAXONOMY.json order); its strip is his art
		strip e26/fw 4                        #     e26/fw/<id>: 680x43 = 4 x 170x43, normal, checked, pressed, disabled
		frame normal 0
		frame checked 1
		frame pressed 2
		frame disabled 2                      # [m] the empty grey box while "No" is set (captures 20, 24), his frame 2
		frame checked-disabled 3              # [i] his frame 3: the grey tick
		group areas
		enabled-by some
		action toggle
	end
	control cat20
		kind toggle
		rect 320 303 170 43                   # [i] the tenth slot, empty in the period design (nine areas)
		category 20                           # his 20th category (TAXONOMY.json order); its strip is his art
		strip e26/fw 4                        #     e26/fw/<id>: 680x43 = 4 x 170x43, normal, checked, pressed, disabled
		frame normal 0
		frame checked 1
		frame pressed 2
		frame disabled 2                      # [m] the empty grey box while "No" is set (captures 20, 24), his frame 2
		frame checked-disabled 3              # [i] his frame 3: the grey tick
		group areas
		enabled-by some
		action toggle
	end
	control find
		kind button
		record 10082                          # [d] "|^FINDWIZARD_FIND"; its frame slots 3-6 are all entry 28, so the
		                                      #     class's 1-px ring is entry 28 in every state (black at 16 colours
		                                      #     on all four sides, captures 20, 26, 27), not the strip's #52845B
		rect 408 26 90 29                     # [m] (419,107) on capture 20; pressing changes 88x27 at (420,108)
		strip ui/bitmap/FINDWIZARD_FIND 4
		frame normal 0
		frame pressed 1
		frame disabled 2
		frame hot 3
		action wizard.find "Search"
		key Return
	end
	control back
		kind button
		record 10081
		rect 16 307 39 39                     # [m]
		strip ui/bitmap/FINDWIZARD_BACK 4
		frame normal 0
		frame pressed 1
		frame disabled 2
		frame hot 3
		action finder.back "Previous page"
	end
	control next
		kind button
		record 10080
		rect 75 307 39 39                     # [m]
		strip ui/bitmap/FINDWIZARD_NEXT 4
		frame normal 0
		frame pressed 1
		frame disabled 2
		frame hot 3
		action finder.next "Next page"
	end
end


# [i] Added pages use the measured 1995 frame and page rectangles, with own labels. VM goldens are required.
block wizpage
	control picture-column
		kind panel
		rect 1 16 127 339
		bg ui:28
	end
	control page-rule
		kind panel
		rect 128 16 382 1
		bg ui:15
	end
	control column-rule
		kind panel
		rect 128 16 1 339
		bg ui:15
	end
	control panel
		kind panel
		rect 129 17 381 338
		bg ui:13
	end
end

