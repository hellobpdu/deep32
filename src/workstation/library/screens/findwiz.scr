	control minimise-after-select
		kind toggle
		record 10074
		rect 12 244 400 18
		strip ui/bitmap/FINDWIZARD_CHECKBOX 4
		frame normal 0
		frame checked 1
		frame disabled 2
		frame checked-disabled 3
		label "Minimise Pinpointer after selecting an article"
		font ui
		fg ui:15
		text-y 12
		prop setting MinimisePinpointerAfterSelect
		action toggle
	end
