		label "Titles only"
		font ui
		bg ui:14
		fg ui:15
		source finder-scope
		prop scope title
		action finder.scope title
	end
	control highlights
		kind button
		rect 304 229 108 22
		label "Highlights"
		font ui
		bg ui:14
		fg ui:15
		disabled                              # u14: not built yet; greyed instead of the "later build" box
		action finder.highlights "Search highlights"
	end
end

screen finder-lists
	size 430 270
	origin 10 65
