screen pinpointer-time
	prop focus year-from
	size 605 335
	origin 10 65
	over *
	prop viewport native-pinned
	uses pinwin
	uses pinwidecap
	uses pinfilters
	uses pinwide
	control f-time-open
		kind button
		rect 182 207 55 49
		strip ui/bitmap/ENCORG_TIME 4
		frame normal 3
		action goto pinpointer
	end
	control title
		kind label
		rect 247 44 290 20
		label @14703                          # [d] "Click and drag on timeline or type in dates"
		font ui-bold13                        # [m256] Arial Bold 13 px (GetFont 105): capitals on rows 130-139
		fg ui:15
		text-y 15
		align left
	end
	# [m256] capture256 13: the two white date boxes, x 256-396 and 438-578, rows 167-204, each with a bar down its
	# left edge one row shorter (rows 168-204): entry 8 at x 253-255, entry 19 at x 435-437; beside each box its BC
	# and AD toggles (records 10042, 10043: ENCTIM_BC and ENCTIM_AD, four frames of 18x14), disabled until a date is
	# typed: frame 2 (entry-31 face, entry-30 lettering) in the record's white disabled frame, at x 398 and 581,
	# rows 171 and 186
	control year-from
		kind field
		rect 245 86 141 38
		bg ui:0
		font ui13
		fg ui:15
		prop maxlen 14
		action finder.time "Apply dates"
	end
	control from-bar
		kind panel
		rect 242 87 3 37
		bg ui:8
	end
	control from-bc
		kind button
		record 10042
		rect 387 90 18 14
		strip ui/bitmap/ENCTIM_BC 4
		frame normal 0
		frame pressed 1
		frame disabled 2
		frame hot 3
		frame checked 1
		source finder-era
		prop endpoint from
		prop era bc
		prop field year-from
		action finder.time from-bc
	end
	control from-ad
		kind button
		record 10043
		rect 387 105 18 14
		strip ui/bitmap/ENCTIM_AD 4
		frame normal 0
		frame pressed 1
		frame disabled 2
		frame hot 3
		frame checked 1
		source finder-era
		prop endpoint from
		prop era ad
		prop field year-from
		action finder.time from-ad
	end
	control year-to
		kind field
		rect 427 86 141 38
		bg ui:0
		font ui13
		fg ui:15
		prop maxlen 14
		action finder.time "Apply dates"
	end
	control to-bar
		kind panel
		rect 424 87 3 37
		bg ui:19
	end
	control to-bc
		kind button
		record 10042
		rect 570 90 18 14
		strip ui/bitmap/ENCTIM_BC 4
		frame normal 0
		frame pressed 1
		frame disabled 2
		frame hot 3
		frame checked 1
		source finder-era
		prop endpoint to
		prop era bc
		prop field year-to
		action finder.time to-bc
	end
	control to-ad
		kind button
		record 10043
		rect 570 105 18 14
		strip ui/bitmap/ENCTIM_AD 4
		frame normal 0
		frame pressed 1
		frame disabled 2
		frame hot 3
		frame checked 1
		source finder-era
		prop endpoint to
		prop era ad
		prop field year-to
		action finder.time to-ad
	end
	control picture
		kind timeslider
		rect 242 131 345 184                  # [m256] TIMEDKFIL exact at (253,212) (capture256 13)
		strip ui/bitmap/TIMEDKFIL 1
		frame normal 0
		prop year-from year-from
		prop year-to year-to
	end
	control scale-information
		kind button
		rect 426 302 157 18
		label "Scale information"
		font ui
		bg ui:14
		fg ui:15
		action finder.timeline "Time scale artwork"
	end
end

screen pinpointer-place
	prop focus place-id
	size 605 335
	origin 10 65
	over *
	prop viewport native-pinned
	uses pinwin
	uses pinwidecap
	uses pinfilters
	uses pinwide
	control f-place-open
		kind button
		rect 182 258 55 49
		strip ui/bitmap/ENCORG_PLACE 4
		frame normal 3
		action goto pinpointer
	end
	control map
		kind image
		rect 237 72 357 251                   # [m256] PLACEFIL at (248,153), 90.7% exact (the rest is under the buttons)
		strip ui/bitmap/PLACEFIL 1
		frame normal 0
	end
	control title
		kind label
		rect 247 44 280 20
		label @14702                          # [d] "Type a place name or click a button"
		font ui-bold13                        # [m256] Arial Bold 13 px (GetFont 105): capitals on rows 130-139
		fg ui:15
		text-y 15
		align left
	end
	# [m256] the strips' own rings: records 10011-10014 would ring them in entry 31 (1,032 pixels off)
	control p-regions
		kind button
		rect 255 90 111 20                    # [m256] ENCPLC_STREG frame 0 exact at (266,171)
		strip ui/bitmap/ENCPLC_STREG 3
		frame normal 0
		action finder.place regions
	end
	control p-countries
		kind button
		rect 255 120 111 20                   # [m256] (266,201)
		strip ui/bitmap/ENCPLC_CTRY 3
		frame normal 0
		action finder.place countries
	end
	control p-political
		kind button
		rect 255 150 111 20                   # [m256] (266,231)
		strip ui/bitmap/ENCPLC_POLITICAL 3
		frame normal 0
		action finder.place political
	end
	control p-cities
		kind button
		rect 255 180 111 20                   # [m256] (266,261)
		strip ui/bitmap/ENCPLC_CITY 3
		frame normal 0
		action finder.place cities
	end
	# [m256] capture256 14: the place field in a 1-px entry-13 frame (x 401 and 588, rows 171 and 205), an entry-31
	# row inside its top (172), white below (rows 173-204)
	control p-frame
		kind panel
		rect 390 90 188 35
		bg ui:13
	end
	control p-inset
		kind panel
		rect 391 91 186 1
		bg ui:31
	end
	control place-id
		kind field
		rect 391 92 186 32
		bg ui:0
		font ui
		fg ui:15
		prop maxlen 255
		action finder.search "Search"
	end
	control apply-place
		kind button
		rect 391 134 90 18
		label "Apply place"
		font ui
		bg ui:14
		fg ui:15
		action finder.search "Search"
	end
end
