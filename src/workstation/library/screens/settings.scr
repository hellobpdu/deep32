d32scr 1
# the period design capture256 63. Measured geometry and string IDs are in T-0065 EVIDENCE.md.
# The caption controls are local because screen blocks are loaded per file.
screen settings
	size 491 261
	origin 72 85
	over *
	prop viewport native-centred
	ground ui:15
	# Main and Article start at (1,16), giving the measured outer origin (73,101).
	# Colour 0 represents the whole radio group in the Tab order. Arrows choose its value.
	prop tab-order "settings-option-0 settings-option-1 settings-option-2 settings-option-3 settings-option-4 settings-option-5 settings-colour-0 settings-word-processor settings-theme settings-ok settings-reset settings-close"

	control settings-caption
		kind bar
		rect 1 1 489 15
		bg ui:27
		fg ui:0
		label @13043
		font ui
		tracking 3
		marker
		text-x 17
		text-y 12
	end
	control settings-close-separator
		kind panel
		rect 455 4 1 9
		bg ui:7
	end
	control settings-close
		kind label
		rect 456 3 33 11
		bg ui:27
		fg ui:31
