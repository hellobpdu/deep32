#!/bin/ksh
# d32-display: Deep32/UX screen layout for the laptop panel and an external monitor (update 2, lid and dock lane).
#
# Data-driven: the laptop panel is the output whose name matches PANEL_OUTPUT (default eDP*); every other output
# that X reports "connected" WITH at least one mode is an external. Output names are never hard-coded, because the
# WD19's monitor has not been seen yet (it may be DP-n, DP-n-m through MST, or HDMI-1 on the laptop's own port).
#
#   d32-display greeter   from /etc/dt/config/Xsetup, as root, before the login box (dtlogin's DISPLAY/XAUTHORITY)
#   d32-display session   from Xsession.d/0005.d32display, as the user, before dtsession and dtwm start
#   d32-display dock      from d32-dock (as the console user) after the dock arrives: waits for the monitor
#   d32-display undock    from d32-dock (as the console user) after the dock leaves: the panel back on, alone
#   d32-display status    prints what X reports and what would be done; changes nothing (any user, needs DISPLAY)
#   add -n to any verb for a dry run (the xrandr command is printed and logged, not run)
#
# With an external: it becomes primary at +0+0 with its preferred mode (xrandr --auto), and the panel is either
# mirrored (--same-as) or off, by the policy for that verb (PANEL_GREETER, PANEL_SESSION, PANEL_DOCK in
# /etc/d32/dock.conf: mirror | off | auto, where auto is off with the lid closed and mirror with it open).
# Without one: the panel on, primary, and any output still lit for a monitor that has gone is switched off.
#
# Safety rules:
#   - the panel is switched off only after X confirms the external is lit, and only in a second step;
#   - if anything fails, the panel is put back on as the only output;
#   - no laptop panel output (a VM, wsfb) means hands off: nothing is changed;
#   - every xrandr call has a time limit, and the script always exits 0 (dtlogin waits for Xsetup).
# Defaults: greeter mirror (the login box must never depend on a monitor that may not really be showing),
# session auto (he has just logged in, so the screen he used works), dock mirror (a lid opened later still shows).
# After a mid-session dock or undock that changes the screen size, dtwm is asked to restart (RESTART_WM=yes) so the
# front panel is placed for the new size; a session that starts on the right layout needs no restart.

PATH=/bin:/usr/bin:/sbin:/usr/sbin:/usr/X11R6/bin
export PATH
umask 022

CONF=/etc/d32/dock.conf
XRANDR=/usr/X11R6/bin/xrandr
TAG=d32-display

PANEL_OUTPUT='eDP*'
PANEL_GREETER=mirror
PANEL_SESSION=auto
PANEL_DOCK=mirror
PREFER=''
DOCK_WAIT=12
RESTART_WM=yes

verb=${1:-status}
dry=0
[ "${2:-}" = -n ] && dry=1
[ "$verb" = -n ] && { dry=1; verb=${2:-status}; }

log() {
	[ "$verb" = status ] || [ $dry = 1 ] || logger -t "$TAG" -p user.notice -- "$verb: $*" 2>/dev/null
	[ -t 2 ] && print -r -- "$TAG: $*" >&2
	return 0
}

# Read the display keys from the schg config. Parsed, never sourced: this also runs as the user.
readconf() {
	[ -r "$CONF" ] || return 0
	while IFS= read -r _l; do
		case $_l in ''|'#'*) continue ;; esac
		_k=${_l%%=*}; _v=${_l#*=}
		[ "$_k" = "$_l" ] && continue
		_v=${_v%%#*}
		_v=$(print -r -- "$_v" | sed -e 's/^[[:blank:]]*//' -e 's/[[:blank:]]*$//' -e 's/^"\(.*\)"$/\1/')
		case $_k in
		PANEL_OUTPUT)	case $_v in *[!A-Za-z0-9*_-]*|'') ;; *) PANEL_OUTPUT=$_v ;; esac ;;
		PANEL_GREETER|PANEL_SESSION|PANEL_DOCK)
				case $_v in mirror|off|auto) eval "$_k=\$_v" ;; esac ;;
		PREFER)		case $_v in *[!A-Za-z0-9\ _-]*) ;; *) PREFER=$_v ;; esac ;;
		DOCK_WAIT)	case $_v in ''|*[!0-9]*) ;; *) [ "$_v" -le 60 ] && DOCK_WAIT=$_v ;; esac ;;
		RESTART_WM)	case $_v in yes|no) RESTART_WM=$_v ;; esac ;;
		esac
	done <"$CONF"
}

# The lid: "open", "closed" or "unknown" (acpibtn's sensor; unknown counts as open everywhere).
lidstate() {
	_s=$(sysctl hw.sensors 2>/dev/null | grep -m 1 '(lid open)')
	case $_s in
	*=On\ *)	print open ;;
	*=Off\ *)	print closed ;;
	*)		print unknown ;;
	esac
}

# One line per output: name status enabled(0|1) primary(0|1) modes geometry
# --query probes the connectors (EDID); --current reports what X already knows (used to verify).
outputs() {
	timeout 15 $XRANDR ${1:---query} 2>/dev/null | awk '
	function flush() { if (name != "") printf "%s %s %d %d %d %s\n", name, st, (geo != "-"), prim, nm, geo }
	/^Screen [0-9]+:/ { next }
	/^[^ \t]/ {
		flush()
		name = $1; st = $2; prim = 0; geo = "-"; nm = 0
		for (i = 3; i <= NF; i++) {
			if ($i == "primary") prim = 1
			else if ($i ~ /^[0-9]+x[0-9]+[+-][0-9]+[+-][0-9]+$/) geo = $i
			else if ($i ~ /^\(/) break
		}
		next
	}
	/^[ \t]+[0-9]+x[0-9]+/ { if (name != "") nm++ }
	END { flush() }'
}

ispanel() {
	case $1 in $PANEL_OUTPUT) return 0 ;; esac
	return 1
}

# Fills: panel, exts (usable externals, preferred first), stale (lit but not usable, to switch off), all
survey() {
	panel=''; exts=''; stale=''; all=''
	_list=$(outputs "$1")
	[ -n "$_list" ] || return 1
	_ordered=''
	while read -r _n _st _en _pr _nm _geo; do
		all="$all $_n"
		if ispanel "$_n"; then
			[ -z "$panel" ] && panel=$_n
			continue
		fi
		if [ "$_st" = connected ] && [ "$_nm" -gt 0 ]; then
			_ordered="$_ordered $_n"
		elif [ "$_en" = 1 ]; then
			stale="$stale $_n"
		fi
	done <<EOF
$_list
EOF
	for _p in $PREFER; do
		case " $_ordered " in *" $_p "*) exts="$exts $_p" ;; esac
	done
	for _o in $_ordered; do
		case " $exts " in *" $_o "*) ;; *) exts="$exts $_o" ;; esac
	done
	exts=${exts# }; stale=${stale# }
	return 0
}

enabled() {	# enabled NAME: X (--current) shows it lit
	outputs --current | awk -v n="$1" '$1 == n && $3 == 1 { f = 1 } END { exit !f }'
}

run() {
	log "xrandr $*"
	[ $dry = 1 ] && { print -r -- "xrandr $*"; return 0; }
	timeout 20 $XRANDR "$@" >/dev/null 2>&1
}

panel_only() {
	set -- --output "$panel" --auto --primary
	for _o in $stale $exts; do set -- "$@" --output "$_o" --off; done
	run "$@"
}

already_panel_only() {	# nothing to do when the panel is the only lit output and primary
	outputs --current | awk -v p="$panel" '
		$1 == p { if ($3 == 1 && $4 == 1) ok = 1 }
		$1 != p && $3 == 1 { other = 1 }
		END { exit !(ok && !other) }'
}

apply() {	# apply POLICY
	_pol=$1
	if [ -z "$exts" ]; then
		if already_panel_only; then
			log "no external monitor; the panel ($panel) is already the only screen"
			return 0
		fi
		log "no external monitor: the panel ($panel) alone"
		panel_only
		return 0
	fi
	set -- $exts; _e=$1; shift
	_lid=$(lidstate)
	if [ "$_pol" = auto ]; then
		if [ "$_lid" = closed ]; then _pol=off; else _pol=mirror; fi
	fi
	log "external $_e (connected: $exts; lid $_lid): primary, panel $_pol"
	# Step 1: the external on and primary, the panel mirrored for now, everything else mirrored or off.
	set -- --output "$_e" --auto --primary --pos 0x0
	for _o in $exts; do [ "$_o" = "$_e" ] || set -- "$@" --output "$_o" --auto --same-as "$_e"; done
	set -- "$@" --output "$panel" --auto --same-as "$_e"
	for _o in $stale; do set -- "$@" --output "$_o" --off; done
	run "$@"
	[ $dry = 1 ] && { [ "$_pol" = off ] && run --output "$panel" --off; return 0; }
	if ! enabled "$_e"; then
		log "the external $_e did not light: back to the panel alone"
		panel_only
		return 0
	fi
	# Step 2: only now, and only if the policy says so, the panel off.
	if [ "$_pol" = off ]; then
		run --output "$panel" --off
		if ! enabled "$_e"; then
			log "the external $_e went dark after the panel was switched off: panel back on"
			panel_only
		fi
	fi
	return 0
}

screensize() {	# the X screen (root) size, e.g. 3440x1440
	timeout 10 $XRANDR --current 2>/dev/null |
	    sed -n 's/^Screen [0-9]*:.* current \([0-9]*\) x \([0-9]*\),.*/\1x\2/p' | head -n 1
}

# After a mid-session change of the screen size, dtwm still places the front panel for the old size (it reads the
# geometry once, at start). With RESTART_WM=yes, ask dtwm to restart itself the way Style Manager does
# (_DtWmRestartNoConfirm: "f.restart -noconfirm" appended to _DT_WM_REQUEST on the window named in _MOTIF_WM_INFO).
# Windows and workspaces stay; only dtwm is re-executed.
wm_refresh() {
	[ "$RESTART_WM" = yes ] || return 0
	[ "$verb" = dock ] || [ "$verb" = undock ] || return 0
	_now=$(screensize)
	[ -n "$size0" ] && [ -n "$_now" ] && [ "$size0" != "$_now" ] || return 0
	_w=$(timeout 5 xprop -root _MOTIF_WM_INFO 2>/dev/null | sed -n 's/.*= *[^,]*, *\(0x[0-9a-fA-F]*\).*/\1/p')
	case $_w in 0x[0-9a-fA-F]*) ;; *) log "screen $size0 -> $_now, but no dtwm window found: front panel left as is"; return 0 ;; esac
	log "screen $size0 -> $_now: restarting dtwm (window $_w) so the front panel follows"
	[ $dry = 1 ] && { print -r -- "xprop -id $_w -f _DT_WM_REQUEST 8s -set _DT_WM_REQUEST 'f.restart -noconfirm'"; return 0; }
	timeout 5 xprop -id "$_w" -f _DT_WM_REQUEST 8s -set _DT_WM_REQUEST 'f.restart -noconfirm' >/dev/null 2>&1
	return 0
}

main() {
	readconf
	case $verb in
	greeter|session|dock|undock|status) ;;
	*)	print -u2 "usage: d32-display greeter|session|dock|undock|status [-n]"; exit 2 ;;
	esac
	if [ -z "${DISPLAY:-}" ] || [ ! -x $XRANDR ]; then
		log "no DISPLAY or no xrandr: nothing done"
		exit 0
	fi
	size0=$(screensize)
	if ! survey --query; then
		log "xrandr gave no answer (X busy, grabbed or gone): nothing done"
		exit 0
	fi
	if [ -z "$panel" ]; then
		log "no output matches '$PANEL_OUTPUT' (a VM or a desktop): layout left alone"
		[ "$verb" = status ] && print "outputs:$all"
		exit 0
	fi
	case $verb in
	status)
		print "panel: $panel   lid: $(lidstate)"
		print "externals (usable, in the order used): ${exts:-none}"
		print "lit but gone (would be switched off): ${stale:-none}"
		print "policy: greeter $PANEL_GREETER, session $PANEL_SESSION, dock $PANEL_DOCK; restart dtwm $RESTART_WM"
		print "screen: ${size0:-unknown}"
		outputs --current | awk '{ printf "  %-10s %-12s %s%s\n", $1, $2, ($3 ? $6 : "off"), ($4 ? " primary" : "") }'
		;;
	greeter)	apply "$PANEL_GREETER" ;;
	session)	apply "$PANEL_SESSION" ;;
	undock)		apply mirror; wm_refresh ;;
	dock)
		# DP Alt Mode needs a moment after the USB side: probe again until a monitor shows or DOCK_WAIT runs out.
		_t=0
		while [ -z "$exts" ] && [ $_t -lt $DOCK_WAIT ]; do
			sleep 2; _t=$((_t + 2))
			survey --query || break
		done
		if [ -z "$exts" ]; then
			log "docked, but no external monitor reported within ${DOCK_WAIT}s: layout unchanged"
			exit 0
		fi
		apply "$PANEL_DOCK"
		wm_refresh
		;;
	esac
	exit 0
}

main
