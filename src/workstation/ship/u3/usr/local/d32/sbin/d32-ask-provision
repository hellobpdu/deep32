#!/bin/ksh
# UPDATE ONLY: run once as root in the single-user/boot window, before d32chat.
# Secrets are handled inside Python; never pass them as arguments or through stdout.
set +x
set -eu
PATH=/bin:/usr/bin:/sbin:/usr/sbin:/usr/local/bin
export PATH
umask 077
ulimit -c 0
[ "$(id -u)" = 0 ] || { print -u2 'd32-ask-provision: root is required'; exit 1; }
exec /usr/local/bin/python3.14 -I -B - <<'PY'
import os
import re
import resource
import secrets
import stat
import subprocess
import sys
import tempfile
from pathlib import Path

ENV = Path('/etc/d32/edge.env')
STATE = Path('/etc/d32/state/chat')
TOKEN = STATE / 'edge.token'
FRONT = Path('/etc/d32/state/edge_front')
MAX_ENV = 64 * 1024  # The shims' d32svc.ENV_MAX_BYTES.


def refuse():
    # Deliberately exclude exception strings, values and file contents.
    raise RuntimeError('provisioning refused')


def directory(path, private=False):
    st = path.lstat()
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022:
        refuse()
    if private and stat.S_IMODE(st.st_mode) != 0o700:
        refuse()


def read_private(path, limit, modes):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(fd, 'rb') as source:
        st = os.fstat(source.fileno())
        if (not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_nlink != 1
                or stat.S_IMODE(st.st_mode) not in modes):
            refuse()
        data = source.read(limit + 1)
        if len(data) > limit:
            refuse()
    return data, stat.S_IMODE(st.st_mode)


def atomic(path, data, mode):
    directory(path.parent)
    fd, name = tempfile.mkstemp(prefix='.ask-', dir=path.parent)
    try:
        with os.fdopen(fd, 'wb') as target:
            os.fchmod(target.fileno(), mode)
            os.fchown(target.fileno(), 0, 0)
            target.write(data)
            target.flush()
            os.fsync(target.fileno())
        os.replace(name, path)
        parent_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(parent_fd)
        finally:
            os.close(parent_fd)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def provision():
    os.umask(0o077)
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    if os.geteuid() != 0:
        refuse()
    level = subprocess.check_output(['/sbin/sysctl', '-n', 'kern.securelevel'],
                                    stderr=subprocess.DEVNULL)
    if int(level.strip()) > 0:
        refuse()
    for path in (Path('/etc/d32'), Path('/etc/d32/state')):
        directory(path)
    try:
        STATE.mkdir(mode=0o700)
    except FileExistsError:
        pass
    directory(STATE, private=True)
    raw, mode = read_private(ENV, MAX_ENV, {0o400, 0o600})
    lines = raw.decode('utf-8').splitlines(keepends=True)
    slot = None
    old = ''
    # Match the shims' parse_env grammar (data, never sourced as a shell).
    # Ambiguous duplicate assignments are refused rather than hiding old tokens.
    for index, source_line in enumerate(lines):
        line = source_line.strip()
        if not line or line.startswith('#'):
            continue
        key, sep, value = line.partition('=')
        key = key.strip()
        if not sep or re.fullmatch(r'[A-Z_][A-Z0-9_]*', key) is None:
            refuse()
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in '\"\'':
            value = value[1:-1]
        if key == 'RAG_MCP_TOKENS':
            if slot is not None:
                refuse()
            slot, old = index, value
    if TOKEN.exists() or TOKEN.is_symlink():
        token_bytes, _ = read_private(TOKEN, 65, {0o600})
        if re.fullmatch(rb'[0-9a-f]{64}\n?', token_bytes) is None:
            refuse()
        token = token_bytes.decode('ascii').strip()
    else:
        token = secrets.token_hex(32)
        # Persist first: after interruption, a retry reuses this token and appends it.
        atomic(TOKEN, (token + '\n').encode('ascii'), 0o600)
    if token not in [part.strip() for part in old.split(',')]:
        # Every existing accepted token stays in the comma-separated list.
        value = old + (',' if old else '') + token
        replacement = 'RAG_MCP_TOKENS=' + value + '\n'
        if slot is None:
            if lines and not lines[-1].endswith(('\n', '\r')):
                lines[-1] += '\n'
            lines.append(replacement)
        else:
            lines[slot] = replacement
        updated = ''.join(lines).encode('utf-8')
        if len(updated) > MAX_ENV:
            refuse()
        atomic(ENV, updated, mode)
    # Shims bind the query-only 127.0.0.1:8766 backend only when this flag is on.
    # This does not enable d32front, relayd, a public listener or any network rule.
    if FRONT.exists() or FRONT.is_symlink():
        read_private(FRONT, 64, {0o400, 0o600})
    atomic(FRONT, b'on\n', 0o600)
    # Update 3: restart d32edge only where it runs already. In the boot window it does not run yet and /etc/rc
    # starts it later in the same boot with the flag on; a start from here would make rc start a second one
    # (rc.subr skips its running check under rc).
    if subprocess.run(['/usr/sbin/rcctl', 'check', 'd32edge'], stdout=subprocess.DEVNULL,
                      stderr=subprocess.DEVNULL).returncode == 0:
        subprocess.run(['/usr/sbin/rcctl', 'restart', 'd32edge'], check=True,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


try:
    provision()
except BaseException:
    print('d32-ask-provision: failed; check the update phase, ownership and d32edge locally; no secret was displayed',
          file=sys.stderr)
    sys.exit(1)
print('d32-ask-provision: ready; existing MCP tokens retained')
PY
