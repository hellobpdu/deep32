# Existing ship/apps D32LibrarySubpanel has hints 20-24; Ask follows at 25.
CONTROL D32AskDeep32Ctl
{
  TYPE                 icon
  CONTAINER_NAME       D32LibrarySubpanel
  CONTAINER_TYPE       SUBPANEL
  POSITION_HINTS       25
  ICON                 D32srch
  LABEL                Ask Deep32
  PUSH_ACTION          D32AskDeep32
  HELP_STRING          Ask Codex or Claude Code on the paired PC using this workstation's RAG.
}
