#!/bin/ksh
set -eu
set -o pipefail
umask 077
export PATH=/bin:/usr/bin:/usr/X11R6/bin

[ "$#" -eq 2 ] || exit 64
case $1 in E|S) mode=$1 ;; *) exit 64 ;; esac
case ${DISPLAY:-} in
	:[0-9]|:[0-9][0-9]|:[0-9].[0-9]|:[0-9][0-9].[0-9]) ;;
	*) exit 64 ;;
esac
case $2 in /*) export XAUTHORITY=$2 ;; '') unset XAUTHORITY ;; *) exit 64 ;; esac

session=$(mktemp -d /tmp/d32-ws.XXXXXXXX)
nested_pid=
cleanup() {
	if [ -n "$nested_pid" ]; then
		kill "$nested_pid" 2>/dev/null || :
		wait "$nested_pid" 2>/dev/null || :
	fi
	rm -f -- "$session/auth" "$session/xephyr.log"
	rmdir -- "$session"
}
trap cleanup EXIT
trap 'exit 75' HUP INT TERM

number=170
while [ "$number" -le 189 ]; do
	if [ ! -e "/tmp/.X${number}-lock" ] && [ ! -e "/tmp/.X11-unix/X${number}" ]; then
		break
	fi
	number=$((number + 1))
done
[ "$number" -le 189 ] || exit 69
nested=:$number
cookie=$(openssl rand -hex 16)
: > "$session/auth"
printf 'add %s MIT-MAGIC-COOKIE-1 %s\n' "$nested" "$cookie" | xauth -q -f "$session/auth"

Xephyr "$nested" -name Wireshark -title Wireshark -resizeable -screen 1152x720 \
	-nolisten tcp -auth "$session/auth" -noreset -extension MIT-SHM \
	> "$session/xephyr.log" 2>&1 &
nested_pid=$!
unset XAUTHORITY
attempt=0
until env XAUTHORITY="$session/auth" timeout 2 xdpyinfo -display "$nested" >/dev/null 2>&1; do
	[ "$attempt" -lt 30 ] && kill -0 "$nested_pid" 2>/dev/null || exit 69
	attempt=$((attempt + 1))
	sleep 0.1
done
kill -0 "$nested_pid" 2>/dev/null || exit 69

exec 3<&0
{
	printf '%s %s\n' "$mode" "$cookie"
	if [ "$mode" = S ]; then cat <&3; fi
} | env -i DISPLAY="$nested" /usr/bin/doas -n -u d32net /usr/local/d32/sbin/wireshark-run 3<&- &
peer_pid=$!
exec 3<&-
wait "$peer_pid"
