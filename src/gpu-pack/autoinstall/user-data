#cloud-config
# TEMPLATE: render-settings.py makes a per-install copy. Never boot this template.
autoinstall:
  version: 1
  refresh-installer:
    update: false
  source:
    id: ubuntu-server-minimal
  locale: en_GB.UTF-8
  keyboard:
    layout: TO-SET-KEYBOARD
  timezone: TO-SET-TIMEZONE
  network:
    version: 2
    ethernets:
      wired:
        match:
          name: "e*"
        dhcp4: true
  apt:
    fallback: offline-install
    geoip: false
  ssh:
    install-server: false
    allow-pw: false
  storage:
    layout:
      name: direct
      match:
        serial: TO-SET-DISK-SERIAL
  user-data:
    preserve_hostname: false
    hostname: TO-SET-NODE
    users:
      - name: TO-SET-USER
        lock_passwd: true
        shell: /bin/bash
        groups: [adm, sudo]
    disable_root: true
  late-commands:
    - mkdir -p /target/etc/deep32-forge
    - cp /run/deep32-settings.json /target/etc/deep32-forge/settings.json
    - mkdir -p /target/opt/deep32-forge /target/opt/deep32-payload
    - cp -a /cdrom/deep32/kit/. /target/opt/deep32-forge/
    - cp -a /cdrom/deep32/payload/. /target/opt/deep32-payload/
    - cp /cdrom/deep32/PAYLOAD.json /target/opt/PAYLOAD.json
    - curtin in-target -- bash /opt/deep32-forge/autoinstall/install-packages.sh --form iso
    - curtin in-target -- bash /opt/deep32-forge/firstboot/install.sh --form iso
  shutdown: reboot
