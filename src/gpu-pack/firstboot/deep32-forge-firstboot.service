[Unit]
Description=Deep32 Forge first boot
After=network-online.target docker.service tailscaled.service cloud-final.service
Wants=network-online.target docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -B /opt/deep32-forge/firstboot/firstboot.py
UMask=0077
# An expired pairing window needs an explicit resume, never an automatic renewal.
Restart=no
TimeoutStopSec=15
KillMode=control-group
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
